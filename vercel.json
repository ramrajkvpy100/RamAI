{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)android' ':(exclude)video' ':(exclude)marketing' ':(exclude)tests' ':(exclude)scripts' ':(exclude)*.md'",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "30 13 * * *"
    }
  ],
  "regions": [
    "bom1"
  ]
}
