# ---------------------------------------------------------------------------
# RamAI — environment configuration
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Seals case-session tokens (AES-256-GCM). REQUIRED in production, ≥ 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
RAMAI_SESSION_SECRET=

# Which clinical engine backs the simulation.
#   mock   — fully offline, scripted case library (default; no key required)
#   openai — live generative simulation via the OpenAI API
RAMAI_ENGINE=mock

# OpenAI credentials. Server-side only — never prefixed with NEXT_PUBLIC_.
# With RAMAI_ENGINE=openai the model words patient replies, interprets questions the
# rules can't place, and writes debrief feedback; patients, results and scoring stay in code.
# OPENAI_MODEL defaults to gpt-6-luna; it is never switched automatically.
# RAMAI_AI_VOICE=unscripted saves credits: scripted answers stay free, only other questions use the model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: request timeout for the clinical engine, in milliseconds.
RAMAI_ENGINE_TIMEOUT_MS=45000

# Accounts, results and leaderboards — SQLite, in one of two places:
#   • a local file (development, or a server with a persistent disk): RAMAI_DB_PATH,
#     default ./data/ramai.db
#   • Turso, SQLite in the cloud (Vercel and other serverless hosts, whose disks don't
#     keep files). In Vercel: Storage → Turso → connect to this project; it fills in:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
RAMAI_DB_PATH=

# The public address of the app, used in links inside emails. On Vercel it defaults to the
# production address; set it for other hosts, e.g. https://ramai.app.
RAMAI_APP_URL=

# Sign-in: Supabase Auth (passwords, 6-digit email codes, password-reset links).
# Supabase dashboard → Project Settings → API Keys (and Data API for the URL).
# Both are PUBLIC values. Without them, only the guest demo works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional, SERVER-ONLY — never put it in a NEXT_PUBLIC_ variable: lets "Delete account"
# also remove the Supabase sign-in record (otherwise remove it in Authentication → Users).
SUPABASE_SECRET_KEY=

# Backups. The running server backs the database up every RAMAI_BACKUP_INTERVAL_HOURS
# (default 24; 0 = off) into RAMAI_BACKUP_DIR (default ./data/backups), keeping the newest
# RAMAI_BACKUP_KEEP (default 14). Point RAMAI_BACKUP_MIRROR_DIR at a synced folder
# (Google Drive, Dropbox, iCloud) or another disk to keep a copy off this machine.
# Manual: `npm run backup`, `npm run backup -- --list`, `npm run restore -- latest` (stop the server first).
RAMAI_BACKUP_INTERVAL_HOURS=24
RAMAI_BACKUP_DIR=
RAMAI_BACKUP_KEEP=14
RAMAI_BACKUP_MIRROR_DIR=

# Payments (Razorpay). Without both keys, upgrading is unavailable in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Demo conveniences — NEVER set these on a real deployment.
#   RAMAI_SEED_DEMO=1     fictional demo doctors (labelled "Demo") fill the leaderboards and play in every league
#   RAMAI_DEMO_BILLING=1  lets you activate Pro without payment to test Pro levels (ignored in production)
RAMAI_SEED_DEMO=
RAMAI_DEMO_BILLING=
