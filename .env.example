# ---------------------------------------------------------------------------
# RamAI — environment configuration
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Seals case-session tokens (AES-256-GCM). REQUIRED in production, ≥ 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
RAMAI_SESSION_SECRET=

# Which clinical engine backs the simulation.
#   mock   — fully offline, scripted case library (default; no key required)
#   openai — live generative simulation via the OpenAI API
RAMAI_ENGINE=mock

# OpenAI credentials. Server-side only — never prefixed with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: request timeout for the clinical engine, in milliseconds.
RAMAI_ENGINE_TIMEOUT_MS=45000

# Accounts, results and leaderboards (SQLite via node:sqlite).
# Defaults to ./data/ramai.db — point it at a persistent volume in production.
RAMAI_DB_PATH=

# The public address of the app, used in links inside emails. REQUIRED in production,
# e.g. https://ramai.app — without it, emails can only link to local addresses.
RAMAI_APP_URL=

# Email (verification, password reset). Without a provider, emails are not sent:
# they are saved to ./data/outbox and printed in the server log (fine for local use).
#   RAMAI_EMAIL_PROVIDER=resend   with RESEND_API_KEY from resend.com (verify your domain there)
RAMAI_EMAIL_PROVIDER=
RESEND_API_KEY=
RAMAI_EMAIL_FROM=RamAI <no-reply@yourdomain.com>

# Backups. The running server backs the database up every RAMAI_BACKUP_INTERVAL_HOURS
# (default 24; 0 = off) into RAMAI_BACKUP_DIR (default ./data/backups), keeping the newest
# RAMAI_BACKUP_KEEP (default 14). Point RAMAI_BACKUP_MIRROR_DIR at a synced folder
# (Google Drive, Dropbox, iCloud) or another disk to keep a copy off this machine.
# Manual: `npm run backup`, `npm run backup -- --list`, `npm run restore -- latest` (stop the server first).
RAMAI_BACKUP_INTERVAL_HOURS=24
RAMAI_BACKUP_DIR=
RAMAI_BACKUP_KEEP=14
RAMAI_BACKUP_MIRROR_DIR=

# Payments (Razorpay). Without both keys, upgrading is unavailable in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Demo conveniences — NEVER set these on a real deployment.
#   RAMAI_SEED_DEMO=1     fictional demo doctors (labelled "Demo") fill the leaderboards and play in every league
#   RAMAI_DEMO_BILLING=1  lets you activate Pro without payment to test Pro levels (ignored in production)
RAMAI_SEED_DEMO=
RAMAI_DEMO_BILLING=
