<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RamAI" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_daily" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Daily case" android:textColor="#E6FFFFFF" android:textSize="13sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <TextView android:id="@+id/widget_case" style="@style/WidgetChip" android:text="🩺 Case" />
        <TextView android:id="@+id/widget_skills" style="@style/WidgetChip" android:text="🔍 Skills" />
        <TextView android:id="@+id/widget_focus" style="@style/WidgetChip" android:text="⏱ Focus" />
        <TextView android:id="@+id/widget_exams" style="@style/WidgetChip" android:text="📝 MCQs" />
    </LinearLayout>
</LinearLayout>
