<?xml version="1.0" encoding="utf-8"?>
<!--
  Planner widget: what to do next, today's most important task and the open to-dos and habits — each ticked off
  right here with a tap. ↻ refreshes; tapping the title opens the planner.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/plan_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_plan_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/plan_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="⭐ TODAY" android:textColor="#B45309" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" />
        <TextView android:id="@+id/plan_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#92400E" android:textSize="12sp" android:textStyle="bold" android:paddingEnd="8dp" />
        <TextView android:id="@+id/plan_refresh" android:layout_width="30dp" android:layout_height="30dp" android:gravity="center" android:text="↻" android:textColor="#92400E" android:textSize="17sp" android:background="@drawable/widget_chip" />
    </LinearLayout>

    <ProgressBar android:id="@+id/plan_bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="6dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_plan_bar" />

    <TextView android:id="@+id/plan_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="2" android:ellipsize="end" android:text="Tap to plan your day" android:textColor="#1F2937" android:textSize="16sp" android:textStyle="bold" />

    <TextView android:id="@+id/plan_mit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:maxLines="1" android:ellipsize="end" android:textColor="#78350F" android:textSize="14sp" android:textStyle="bold" android:visibility="gone" />
    <TextView android:id="@+id/plan_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:paddingBottom="3dp" android:maxLines="1" android:ellipsize="end" android:textColor="#374151" android:textSize="14sp" android:visibility="gone" />
    <TextView android:id="@+id/plan_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:paddingBottom="3dp" android:maxLines="1" android:ellipsize="end" android:textColor="#374151" android:textSize="14sp" android:visibility="gone" />
    <TextView android:id="@+id/plan_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:paddingBottom="3dp" android:maxLines="1" android:ellipsize="end" android:textColor="#374151" android:textSize="14sp" android:visibility="gone" />
    <TextView android:id="@+id/plan_row4" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:paddingBottom="3dp" android:maxLines="1" android:ellipsize="end" android:textColor="#374151" android:textSize="14sp" android:visibility="gone" />
    <TextView android:id="@+id/plan_row5" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:paddingBottom="3dp" android:maxLines="1" android:ellipsize="end" android:textColor="#374151" android:textSize="14sp" android:visibility="gone" />
    <TextView android:id="@+id/plan_row6" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:paddingBottom="3dp" android:maxLines="1" android:ellipsize="end" android:textColor="#374151" android:textSize="14sp" android:visibility="gone" />
    <TextView android:id="@+id/plan_foot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="" android:textColor="#92400E" android:textSize="11sp" />
</LinearLayout>
